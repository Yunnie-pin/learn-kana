# OpenAI API Configuration
OPENAI_API_KEY=your-api-key-here

# Umami analytics (optional, leave empty to disable tracking).
# Read at build time: rebuild the app / Docker image after changing them.
REACT_APP_UMAMI_SCRIPT_URL=
REACT_APP_UMAMI_WEBSITE_ID=

# Docker: port on the host machine where the app is served (http://localhost:APP_PORT)
APP_PORT=3000
